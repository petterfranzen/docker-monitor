# Copy to .env alongside docker-compose.yml and fill in. See README.md for
# the full explanation of every option below.

# --- Notification mode ---
# "console": logs what WOULD be emailed to stdout instead of sending it —
#            no SMTP server or credentials needed. Safe default; good for
#            first trying this out, and for CI/local testing.
# "email":   actually sends mail via the SMTP_* settings below.
NOTIFY_MODE=console

# --- SMTP (required only when NOTIFY_MODE=email) ---
# Any SMTP relay works. For Gmail specifically: smtp.gmail.com, port 587,
# SMTP_TLS_MODE=starttls, and an App Password
# (https://myaccount.google.com/apppasswords) as SMTP_PASSWORD — NOT your
# normal Google account password, which Gmail will reject for SMTP login.
# You must supply real credentials here yourself; none are provided.
SMTP_HOST=
SMTP_PORT=587
# starttls (default; typically port 587), ssl (typically port 465), or
# none (only for an internal relay that doesn't require TLS/auth).
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=docker-monitor@example.com
# Who gets the alerts. Comma-separated for more than one recipient.
SMTP_TO=

# --- Polling ---
# How often to check container state, in seconds.
POLL_INTERVAL_SECONDS=30

# --- Restart-loop detection ---
# Flag a container as "restart-looping" once Docker's own restart counter
# for it climbs by this many within this many seconds.
RESTART_LOOP_THRESHOLD=3
RESTART_LOOP_WINDOW_SECONDS=300

# --- Scope: which containers to watch ---
# Leave both blank to watch every container on the host (the default).
# Comma-separated container names, shell-style globs allowed
# (e.g. "flight-tracker-*"). Exclude always wins when a name matches both.
CONTAINER_INCLUDE=
CONTAINER_EXCLUDE=
# Same idea, but by label — each entry is either a bare key (label must be
# present, any value) or key=value. Comma-separated.
LABEL_INCLUDE=
LABEL_EXCLUDE=

# --- Misc ---
# Also send a follow-up email when a problem clears (true/false).
ALERT_ON_RECOVERY=true
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
