# Optional — deploy/docker-compose.yml inlines every one of these as
# ${VAR:-default} already, so pasting/uploading that one file is enough on
# its own (see deploy/README.md). Drop a filled-in copy of this file as
# `.env` alongside docker-compose.yml only if you're running it via `docker
# compose` directly and would rather manage config in a file than edit the
# compose file's own defaults — docker compose reads .env automatically
# and it overrides the :-defaults with no changes needed to the yaml.
# See README.md for the full explanation of every option below.

# --- Image ---
# Which published tag to pull (see ../.github/workflows/docker-publish.yml
# for how tags get built): "latest" tracks the default branch; pin to a
# specific release tag (e.g. "v1.2.0") or short sha if you'd rather not
# move automatically on every push to main.
IMAGE_TAG=latest

# --- Notification mode ---
# "console": logs what WOULD be pushed to stdout — no ntfy server needed.
#            Safe default; good for first trying this out, and for local
#            testing.
# "ntfy":    actually sends a push via the ntfy server at NTFY_URL/NTFY_TOPIC.
NOTIFY_MODE=console

# --- ntfy (required only when NOTIFY_MODE=ntfy) ---
# Defaults point at the ntfy service bundled in docker-compose.yml,
# reachable from inside the compose network as "ntfy". Pointing at an
# existing ntfy server elsewhere on your NAS instead? Change NTFY_URL and
# drop the bundled `ntfy` service from docker-compose.yml.
NTFY_URL=http://ntfy:80
# Pick your own topic name. See README's "Security notes" before using
# this beyond your LAN — ntfy topics are unauthenticated-readable by
# default, so treat the topic name like a shared secret at minimum, or
# turn on ntfy's access control (also documented in the README).
NTFY_TOPIC=
# Port the bundled ntfy service publishes on the host — for the phone/web
# app, and for local testing via http://localhost:$NTFY_PORT.
NTFY_PORT=8080

# --- Polling ---
# How often to check container state, in seconds.
POLL_INTERVAL_SECONDS=30

# --- Restart-loop detection ---
# Flag a container as "restart-looping" once Docker's own restart counter
# for it climbs by this many within this many seconds.
RESTART_LOOP_THRESHOLD=3
RESTART_LOOP_WINDOW_SECONDS=300

# --- Scope: which containers to watch ---
# Leave both blank to watch every container on the host (the default).
# Comma-separated container names, shell-style globs allowed
# (e.g. "flight-tracker-*"). Exclude always wins when a name matches both.
CONTAINER_INCLUDE=
CONTAINER_EXCLUDE=
# Same idea, but by label — each entry is either a bare key (label must be
# present, any value) or key=value. Comma-separated.
LABEL_INCLUDE=
LABEL_EXCLUDE=

# --- Log-content monitoring (watches log TEXT, not just container state) ---
# Global on/off switch for everything below.
LOG_MONITORING_ENABLED=true

# "No data": alert if a running, watched container produces zero new log
# lines for longer than this many seconds — catches something silently
# stuck even though the container is still "running" (and maybe even
# reporting healthy).
NO_DATA_IDLE_SECONDS=600
# Comma-separated names/globs to skip no-data checking for — containers
# that are legitimately quiet most of the time (e.g. a database with no
# active connections) would otherwise false-positive on this check.
NO_DATA_EXCLUDE=

# Built-in log-text pattern matches (each is its own on/off switch).
LOG_PATTERN_RATE_LIMITED_ENABLED=true
# Off by default — "error"/"exception"/"fatal" appears routinely in normal
# logs for plenty of apps, so this is noisy unless you know your stack's
# logs are clean of it. Turn on if useful for your containers.
LOG_PATTERN_GENERIC_ERROR_ENABLED=false
# Optional path to a JSON file of additional/overriding patterns, each
# optionally scoped to specific containers. See README for the format.
LOG_PATTERNS_FILE=

# Traffic-spike detection: a rolling baseline of log lines/minute per
# container; alert if the current rate exceeds the baseline by this
# multiplier, sustained for 2+ consecutive polls (to avoid single-poll
# noise like a normal startup burst).
TRAFFIC_BASELINE_WINDOW_SECONDS=1800
TRAFFIC_SPIKE_MULTIPLIER=5
# Minimum number of "normal" (non-spike) polls needed before a baseline is
# trusted enough to alert against.
TRAFFIC_MIN_BASELINE_SAMPLES=5
# Don't evaluate spikes for a container until it's been watched this long
# — skips the noisy log burst most containers produce right at startup.
TRAFFIC_GRACE_PERIOD_SECONDS=300
# Floor so a near-zero baseline (e.g. 0 -> 1 line/poll) doesn't trivially
# count as "5x the baseline."
TRAFFIC_MIN_RATE_LINES_PER_MIN=2

# --- Misc ---
# Also send a follow-up push when a problem clears (true/false).
ALERT_ON_RECOVERY=true
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
